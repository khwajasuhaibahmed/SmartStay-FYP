PORT=5000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/smartstay
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Gmail used to send verification / password-reset codes.
# SMTP_PASS is a 16-character Google "App Password", not the normal Gmail password.
# Leave both empty to print codes in the backend terminal instead (development).
SMTP_USER=
SMTP_PASS=

# First-time setup page: secret key needed to create the first Super Admin.
SETUP_KEY=change-this-to-a-long-random-key
# Web app address used in emails (login link)
APP_URL=http://localhost:5173
